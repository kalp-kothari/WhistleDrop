# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/whistledrop
TEST_DATABASE_URL=postgres://user:password@localhost:5432/whistledrop_test

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Case code HMAC key. Losing this makes existing case codes untrackable.
CASE_CODE_PEPPER=replace_with_a_long_random_pepper_at_least_32_chars

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_TRACKING=30
RATE_LIMIT_MAX_LOGIN=5
RATE_LIMIT_MAX_SUBMISSIONS=50

# Moderator setup (used only by scripts/createModerator.js)
MODERATOR_USERNAME=admin
MODERATOR_PASSWORD=replace_with_strong_password_min_12_chars
